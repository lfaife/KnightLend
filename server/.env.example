# Copy to server/.env. Never commit the real .env.
MONGODB_URI=mongodb://localhost:27017/knightlend
# auto = try MongoDB, fall back to in-memory mongomock. mongo = MongoDB only. mock = in-memory only.
DB_MODE=auto
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_MINUTES=10080
# Enables the Demo bar endpoints (switch users, advance time, reset). Keep false in production.
DEMO_MODE=true
DEMO_PASSWORD=knightlend-demo
SEED_ON_EMPTY=true
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
MAX_UPLOAD_MB=5
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
